<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type GameListItem}">
 <StackPanel x:Name="PART_PanelHost">
 <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}" Background="Transparent">
 <Image x:Name="PART_ImageCover" Stretch="{Settings CoverArtStretch}"/>
 <Image x:Name="MoondancerIcon" Visibility="Collapsed" Source="{Binding Game.Icon, Converter={StaticResource ImageStringToImageConverterCached}}" Stretch="Uniform"/>
 <Image x:Name="MoondancerBackground" Visibility="Collapsed" Source="{Binding Game.BackgroundImage, Converter={StaticResource ImageStringToImageConverterCached}}" Stretch="Uniform"/>
 <TextBlock x:Name="MoondancerLogoPath" Visibility="Collapsed" Tag="{Api Paths.ConfigurationPath}"><TextBlock.Text><MultiBinding StringFormat="{}{0}\ExtraMetadata\games\{1}\logo.png"><Binding RelativeSource="{RelativeSource Self}" Path="Tag"/><Binding Path="Game.Id"/></MultiBinding></TextBlock.Text></TextBlock>
 <Viewbox x:Name="MoondancerLogoFrame" Visibility="Collapsed" Stretch="Uniform" Margin="6"><Grid x:Name="MoondancerLogoCanvas" Width="160" Height="90" Background="Transparent"><Image Source="{Binding ElementName=MoondancerLogoPath, Path=Text, Converter={StaticResource ImageStringToImageConverter}}" Stretch="Uniform"/></Grid></Viewbox>
 </Grid>
 <TextBlock Text="{Binding DisplayName}" Visibility="{Settings ShowNamesUnderCovers}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
 </StackPanel>
 <ControlTemplate.Triggers>
 <DataTrigger Binding="{PluginSettings Plugin=Moondancer, Path=Desktop.VisualMode}" Value="Icon"><Setter TargetName="PART_ImageCover" Property="Visibility" Value="Collapsed"/><Setter TargetName="MoondancerIcon" Property="Visibility" Value="Visible"/></DataTrigger>
 <DataTrigger Binding="{PluginSettings Plugin=Moondancer, Path=Desktop.VisualMode}" Value="Background"><Setter TargetName="PART_ImageCover" Property="Visibility" Value="Collapsed"/><Setter TargetName="MoondancerBackground" Property="Visibility" Value="Visible"/></DataTrigger>
 <DataTrigger Binding="{PluginSettings Plugin=Moondancer, Path=Desktop.VisualMode}" Value="Logo"><Setter TargetName="PART_ImageCover" Property="Visibility" Value="Collapsed"/><Setter TargetName="MoondancerLogoFrame" Property="Visibility" Value="Visible"/></DataTrigger>
 <DataTrigger Binding="{PluginSettings Plugin=Moondancer, Path=Desktop.VisualMode}" Value="BackgroundLogo"><Setter TargetName="PART_ImageCover" Property="Visibility" Value="Collapsed"/><Setter TargetName="MoondancerBackground" Property="Visibility" Value="Visible"/><Setter TargetName="MoondancerLogoFrame" Property="Visibility" Value="Visible"/></DataTrigger>
 <DataTrigger Binding="{PluginSettings Plugin=Moondancer, Path=Desktop.LogoAspectRatio}" Value="1:1"><Setter TargetName="MoondancerLogoCanvas" Property="Height" Value="160"/></DataTrigger>
 </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>